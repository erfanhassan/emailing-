# ─── AI ─────────────────────────────────────────────────
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ─── Google Sheets ──────────────────────────────────────
GOOGLE_APPLICATION_CREDENTIALS=google_service_account.json
# OR use inline JSON (for cloud environments without file access):
# GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}
GOOGLE_SHEET_URL_OR_ID=your_google_sheet_id_or_url

# ─── Google Places API (Geo-Sourcing) ───────────────────
PLACES_API_KEY=your_google_places_api_key

# ─── Email Provider (choose one) ────────────────────────
SMTP_PROVIDER=Hostinger    # Options: Hostinger | Gmail | Zoho Mail

HOSTINGER_EMAIL=your_email@domain.com
HOSTINGER_PASSWORD=your_hostinger_password

GMAIL_EMAIL=your_gmail@gmail.com
GMAIL_PASSWORD=your_gmail_app_password

ZOHO_EMAIL=your_email@zoho.com
ZOHO_PASSWORD=your_zoho_password

# Active provider credentials (copied from above by app on save)
SMTP_EMAIL=
SMTP_PASSWORD=

# ─── Tracking (GCP VM / Cloud) ──────────────────────────
# Set this to your VM's public IP + port 8000 after deployment
# e.g. http://34.123.45.67:8000  or  https://yourdomain.com
TRACKING_URL=http://YOUR_VM_EXTERNAL_IP:8000

# ─── GCP VM Deployment Notes ────────────────────────────
# 1. Upload this file as .env on your VM (do NOT commit to git)
# 2. Upload google_service_account.json to the same directory
# 3. Run:  docker build -t outreach-app .
# 4. Run:  docker run -d --env-file .env -p 8501:8501 -p 8000:8000 outreach-app
# 5. Open firewall rules for TCP 8501 and TCP 8000
# 6. Access dashboard at: http://YOUR_VM_EXTERNAL_IP:8501
